{
  "framework": null,
  "buildCommand": "next build",
  "outputDirectory": "out",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/docs/components",
      "destination": "/components",
      "permanent": true
    },
    {
      "source": "/docs/components/:slug",
      "destination": "/components/:slug",
      "permanent": true
    },
    {
      "source": "/docs",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/docs/getting-started/:slug",
      "destination": "/",
      "permanent": true
    }
  ]
}
